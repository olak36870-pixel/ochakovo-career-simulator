  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412 1980 \u0433\u043E\u0434\u0443 \u0432\u043E \u0432\u0440\u0435\u043C\u044F
    \u041E\u043B\u0438\u043C\u043F\u0438\u0430\u0434\u044B \u0432 \u041C\u043E\u0441\u043A\u0432\u0435
    \xAB\u041E\u0447\u0430\u043A\u043E\u0432\u043E\xBB \u0441\u0442\u0430\u043B \u0433\u043B\u0430\u0432\u043D\u044B\u043C
    \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u043E\u043C \u043E\u0441\u0432\u0435\u0436\u0430\u044E\u0449\u0438\u0445
    \u043D\u0430\u043F\u0438\u0442\u043A\u043E\u0432 \u0434\u043B\u044F \u0441\u043F\u043E\u0440\u0442\u0441\u043C\u0435\u043D\u043E\u0432
    \u0438 \u0433\u043E\u0441\u0442\u0435\u0439 \u0441\u043E \u0432\u0441\u0435\u0433\u043E
    \u043C\u0438\u0440\u0430! \u0417\u0430\u0432\u043E\u0434 \u0431\u044B\u043B \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u043C\u0435\u0441\u0442\u043E\u043C \u043D\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0435,
    \u0433\u0434\u0435 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
    \u0440\u0430\u0437\u043B\u0438\u0432\u0430\u043B\u0438 \u043D\u0430\u043F\u0438\u0442\u043A\u0438
    \u0432\u0435\u0447\u043D\u044B\u0445 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432
    \u2014 Pepsi \u0438 Fanta. \u041D\u0430\u0448\u0438 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438
    \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u044B \u0441\u0430\u043C\u043E\u0433\u043E
    \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0433\u043E \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0c2829df87d7f6342b4874bd680b9286, type: 2}
