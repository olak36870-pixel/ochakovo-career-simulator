  m_text: "\u0417\u0430 \u043A\u0430\u0436\u0434\u043E\u0439 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
    \u0435\u0441\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A! \u041F\u043E\u0437\u0432\u043E\u043B\u044C
    \u043D\u0430\u043C \u0443\u0437\u043D\u0430\u0442\u044C \u043A\u0430\u043A\u043E\u0435
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0442\u0435\u0431\u044F
    \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043B\u043E,
    \u0442\u0432\u043E\u0438 \u0424\u0418\u041E \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0439
    \u0440\u043E\u0441\u0442, \u0430 \u044F \u0442\u0435\u0431\u0435 \u0441\u043E\u043E\u0431\u0449\u0443,
    \u043A\u0435\u043C \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0442\u0430\u0442\u044C
    \u0432 \u041E\u0447\u0430\u043A\u043E\u0432\u043E!"
